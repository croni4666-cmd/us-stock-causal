# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual envs
.venv/
venv/
env/
ENV/

# Data (large, regenerable)
data/raw/*.parquet
data/cache/*.parquet
data/cache/alerts/alerts_*.json
*.parquet
*.csv

# Output (regenerable)
output/*.png
output/*.jpg
output/*.html
output/*.pdf
# Keep .md reports
!output/*.md

# Logs
logs/*.log
logs/*.txt

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Jupyter
.ipynb_checkpoints/
*.ipynb_temp/
*.executed.ipynb

# Secrets (none expected, but be safe)
.env
.env.local
*.pem
*.key

# OpenBB cache (regenerable)
.openbb/

# Local commit message drafts (�� git commit -F ���ü���)
commit_msg_*.txt
